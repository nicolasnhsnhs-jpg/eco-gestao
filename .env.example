# Copie este arquivo para ".env.local" e preencha com os dados do projeto Supabase
# (Painel do Supabase → Project Settings → API).
#
# A "anon key" é pública por natureza: ela vai para o navegador e quem protege os dados
# são as regras de permissão (RLS) do banco. Já a "service_role key" é SECRETA e
# NUNCA deve aparecer aqui nem em nenhum arquivo do front-end.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key
