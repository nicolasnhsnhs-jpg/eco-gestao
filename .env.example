# Copie este arquivo para ".env.local" e preencha com os dados do projeto Supabase
# (Painel do Supabase → Project Settings → API Keys).
#
# A "publishable key" é pública por natureza: ela vai para o navegador e quem protege
# os dados são as regras de permissão (RLS) do banco. Já a "secret key" (sb_secret_...)
# é SECRETA e NUNCA deve aparecer aqui nem em nenhum arquivo do front-end.
#
# Formato: NOME=valor (sem espaços nem aspas).

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_cole-aqui
